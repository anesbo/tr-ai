# =====================================================================
# AI Trading Bot Environment Configuration Template
# Copy this file to '.env' and fill in your actual credentials.
# NEVER commit the '.env' file containing real secrets to version control.
# =====================================================================

# Global Bot Settings
PAPER_TRADING=True         # Force paper trading by default for safety (True / False)
EXECUTION_ENGINE=mock      # Options: mock (for zero-setup testing), alpaca, ccxt
STRATEGY=technical         # Options: technical, rl, llm
TRADING_SYMBOL=BTC/USD     # e.g., BTC/USD or AAPL (depends on exchange)
TIMEFRAME=1h               # Timeframe for OHLCV (1m, 5m, 15m, 1h, 1d)

# Risk Settings (Can be overridden here)
MAX_EQUITY_RISK_PCT=0.02   # Max account balance risk per trade (e.g., 2%)
DRAWDOWN_LIMIT_PCT=0.05    # Daily loss drawdown limit before circuit breaker halts (e.g., 5%)
STOP_LOSS_PCT=0.015        # Default stop-loss percentage (1.5%)
TAKE_PROFIT_PCT=0.03       # Default take-profit percentage (3.0%)

# Alpaca API Credentials (Stocks and Crypto Paper/Live)
ALPACA_API_KEY=your_alpaca_api_key_here
ALPACA_SECRET_KEY=your_alpaca_secret_key_here
ALPACA_IS_PAPER=True

# CCXT Exchange Credentials (Crypto)
CCXT_EXCHANGE_ID=binance
CCXT_API_KEY=your_ccxt_api_key_here
CCXT_SECRET_KEY=your_ccxt_secret_key_here
CCXT_PASSWORD=your_ccxt_password_if_required

# LLM / AI API Keys (Used when STRATEGY=llm)
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
